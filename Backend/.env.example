[TEMPLATE]
# Copy this file to .env and fill in secrets. Never commit real keys.

# Which provider to use. Supported values:
#   local | ollama            -> local Ollama only (no cloud)
#   openrouter                -> OpenRouter primary, local Ollama fallback
#   openai_compatible | openai -> any OpenAI-compatible endpoint (default
#                                 points at OpenAI), local Ollama fallback
HERMES_PROVIDER=local

# Common settings
HERMES_MODEL=openai/gpt-5
HERMES_TEMPERATURE=0.2
HERMES_TIMEOUT=60.0
HERMES_SANDBOX_PATH=sandbox

# Local Hermes (provider=local|ollama) — Ollama's default port is 11434.
# Also the automatic fallback for remote providers.
LOCAL_HERMES_URL=http://localhost:11434
LOCAL_HERMES_API_KEY=
LOCAL_HERMES_MODEL=hermes3:8b
LOCAL_HERMES_TIMEOUT=180.0

# OpenRouter (provider=openrouter)
OPENROUTER_API_KEY=
OPENROUTER_URL=https://openrouter.ai/api/v1/chat/completions
OPENROUTER_HTTP_REFERER=
OPENROUTER_X_TITLE=Sarthi

# OpenAI-compatible endpoint (provider=openai_compatible or openai).
# Point OPENAI_COMPATIBLE_URL at any /v1-compatible service (OpenAI, LM
# Studio, vLLM, Together, ...). Keyless local servers work with an empty key.
OPENAI_COMPATIBLE_URL=https://api.openai.com/v1
OPENAI_COMPATIBLE_API_KEY=

# Desktop Agent IPC — where the Brain finds the Desktop Agent process
# (Backend/desktop_agent.py --server, usually on the Windows laptop).
# HOST must be 0.0.0.0 (or the LAN IP) on the laptop for phone/Brain access.
SARTHI_DESKTOP_AGENT_HOST=127.0.0.1
SARTHI_DESKTOP_AGENT_PORT=8765
SARTHI_DESKTOP_AGENT_TIMEOUT=30.0
# Brain-side desktop execution mode: "local" (in-process DesktopHand,
# unchanged behaviour) or "remote" (send actions to the Desktop Agent).
SARTHI_DESKTOP_AGENT_MODE=local

# Browser Awareness (automated browsing). The automation keeps its own
# persistent Chrome profile (registered in sarthi.db on first use) so you
# log in once and stay logged in across runs. Set this to move that
# profile directory; it wins over the database entry. Leave empty for the
# default (Backend/skills/browser_awareness/.chrome-profile).
BROWSER_AWARENESS_PROFILE_DIR=
