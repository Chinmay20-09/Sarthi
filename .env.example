# Copy this file to .env and fill in secrets. Never commit real keys.

# Which provider to use: "local" or "openrouter"
HERMES_PROVIDER=local

# Common settings
HERMES_MODEL=openai/gpt-5
HERMES_TEMPERATURE=0.2
HERMES_TIMEOUT=60.0
HERMES_SANDBOX_PATH=sandbox

# Local Hermes (if using local provider) — Ollama's default port is 11434
LOCAL_HERMES_URL=http://localhost:11434
LOCAL_HERMES_API_KEY=

# OpenRouter (if using openrouter provider)
OPENROUTER_API_KEY=
OPENROUTER_URL=https://openrouter.ai/api/v1/chat/completions
OPENROUTER_HTTP_REFERER=
OPENROUTER_X_TITLE=Sarthi
