# ============================================================================
# Sarthi environment configuration — copy to .env and fill in secrets.
# Do NOT commit .env to source control.
#
# See docs/README_ENV.md for the full variable reference and
# docs/ARCHITECTURE.md (§ Provider Architecture) for selection/fallback.
# ============================================================================

# ----------------------------------------------------------------------------
# Hermes provider selection
# ----------------------------------------------------------------------------
# Which provider Hermes uses. Supported values:
#   local | ollama           — local Ollama only (no cloud calls) [DEFAULT]
#   openrouter               — OpenRouter primary, local Ollama fallback
#   openai_compatible|openai — any OpenAI-compatible endpoint, local fallback
#HERMES_PROVIDER=local

# Model identifier used when calling the provider.
#HERMES_MODEL=openai/gpt-5

# Generation temperature (float).
#HERMES_TEMPERATURE=0.2

# Request timeout in seconds.
#HERMES_TIMEOUT=60

# Path where Hermes sandbox data (task records, traces) is stored.
#HERMES_SANDBOX_PATH=sandbox

# ----------------------------------------------------------------------------
# Local Hermes (Ollama) — default provider, and fallback for remote providers
# ----------------------------------------------------------------------------
#LOCAL_HERMES_URL=http://localhost:11434
#LOCAL_HERMES_API_KEY=
#LOCAL_HERMES_MODEL=hermes3:8b
# Seconds before a local generation is considered failed (CPU inference is
# slow, hence 3x the base timeout).
#LOCAL_HERMES_TIMEOUT=180

# ----------------------------------------------------------------------------
# OpenRouter (only used when HERMES_PROVIDER=openrouter)
# ----------------------------------------------------------------------------
#OPENROUTER_API_KEY=
#OPENROUTER_URL=https://openrouter.ai/api/v1/chat/completions
#OPENROUTER_HTTP_REFERER=
#OPENROUTER_X_TITLE=Sarthi

# ----------------------------------------------------------------------------
# OpenAI-compatible endpoint (HERMES_PROVIDER=openai_compatible | openai)
# ----------------------------------------------------------------------------
#OPENAI_COMPATIBLE_URL=https://api.openai.com/v1
#OPENAI_COMPATIBLE_API_KEY=

# ----------------------------------------------------------------------------
# Hermes agent — complex-task loop bounds (Phase 3f)
# ----------------------------------------------------------------------------
# Maximum tool-requesting model turns per complex task.
#HERMES_AGENT_MAX_ITERATIONS=5
# Wall-clock budget (seconds) for one complex task.
#HERMES_AGENT_TIMEOUT=300

# ----------------------------------------------------------------------------
# Complexity router (Phase 3f) — the fast/complex gate in front of Hermes
# ----------------------------------------------------------------------------
# auto   — heuristic routing (default; simple commands stay fast)
# always — every command is treated as complex (deterministic pipeline still
#          runs first inside the agent)
# off    — never route to Hermes from the /command pipeline
#HERMES_ROUTER_MODE=auto
# Minimum heuristic score for a command to be considered complex (default 1).
#HERMES_ROUTER_MIN_SCORE=1

# ----------------------------------------------------------------------------
# Retrieval (Phase 3f) — bounded context feeding for complex tasks
# ----------------------------------------------------------------------------
#HERMES_RETRIEVAL_ENABLED=true
#HERMES_RETRIEVAL_MAX_CHARS=6000
