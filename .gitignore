# ==========================================
# SQLite
# ==========================================

*.db
*.sqlite
*.sqlite3

# SQLite sidecar files (WAL/shm/journal) carry the same database content —
# chat transcripts, /remember facts, settings, command history, scan results.
# The database is personal data, so all of its artifacts must stay out of git.
# (Note: *.db alone does NOT match *.db-shm / *.db-wal — list them explicitly.)
*.db-shm
*.db-wal
*.db-journal
*.sqlite-shm
*.sqlite-wal
*.sqlite-journal
*.sqlite3-shm
*.sqlite3-wal
*.sqlite3-journal

# ==========================================
# Sandbox (Hermes task artifacts / execution traces)
# ==========================================

sandbox/
sandbox_test/
results/

# ==========================================
# User calibration (ai_chain laptop automation)
# ==========================================

Backend/skills/automation_engine/ai_chain/calibration.json
# Persistent automation Chrome profiles (logins — personal data)
Backend/skills/automation_engine/ai_chain/.chrome-profile/
Backend/skills/browser_awareness/.chrome-profile/

# ==========================================
